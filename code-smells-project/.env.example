# Copie para .env e ajuste os valores. NUNCA versione o .env real.

# OBRIGATÓRIAS: sem elas a aplicação NÃO SOBE (não há mais fallback hardcoded).
# Gere valores fortes, por exemplo: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_TOKEN=

# Conveniência de desenvolvimento: com FLASK_ENV=development, SECRET_KEY/ADMIN_TOKEN
# ausentes são gerados aleatoriamente EM MEMÓRIA a cada boot (valor logado no console,
# muda a cada reinício). Nunca use isso em produção.
FLASK_ENV=production

DEBUG=false
DB_PATH=loja.db
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=5000
# Validade do token de sessão, em segundos (padrão 24h)
TOKEN_MAX_AGE=86400
