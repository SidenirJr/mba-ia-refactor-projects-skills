# Copie para .env e ajuste os valores. NUNCA versione o .env real.

# OBRIGATÓRIA: assina os tokens de sessão. Sem ela a aplicação não sobe.
# Gere um valor forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Em desenvolvimento, FLASK_ENV=development gera uma chave efêmera em memória.
SECRET_KEY=
# FLASK_ENV=development

DEBUG=false
DATABASE_URI=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
# Validade do token de sessão, em segundos (default: 86400 = 24h)
TOKEN_MAX_AGE=86400

# SMTP (opcional — notificações por e-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
