# Copie para .env e PREENCHA os valores. NUNCA versione o .env real.
# ADMIN_TOKEN e PAYMENT_GATEWAY_KEY são OBRIGATÓRIOS e não têm default:
# a aplicação falha na inicialização se eles não vierem do ambiente.
PORT=3000
DB_PATH=:memory:

# Segredos — gere valores próprios, nunca reutilize exemplos de repositório.
# Ex.: ADMIN_TOKEN=$(openssl rand -hex 32)
ADMIN_TOKEN=
PAYMENT_GATEWAY_KEY=
